{
  "manifest_version": 3,
  "name": "Scratch AI Learning Assistant",
  "version": "1.0.0",
  "description": "AI-powered Chrome extension to teach and guide you through learning Scratch programming",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "downloads",
    "windows"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://cdnjs.cloudflare.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scratch AI Assistant"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scratch.mit.edu/*",
        "https://projects.scratch.mit.edu/*"
      ],
      "js": ["selector-map.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selector-map.json", "mascot.png", "vendor/jszip.min.js"],
      "matches": ["https://scratch.mit.edu/*", "https://projects.scratch.mit.edu/*"]
    }
  ]
}

