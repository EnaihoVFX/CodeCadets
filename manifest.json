{
  "manifest_version": 3,
  "name": "Cadet Help",
  "version": "1.0.0",
  "description": "Simple Scratch companion for Code Cadets training",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "downloads",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://cdnjs.cloudflare.com/*",
    "https://scratch.mit.edu/*",
    "https://projects.scratch.mit.edu/*",
    "https://code-cadets.getlearnworlds.com/*",
    "https://*.getlearnworlds.com/*",
    "https://*.supabase.co/*",
    "https://liberatedpixelcup.github.io/*"
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Cadet Help",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/core/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scratch.mit.edu/*",
        "https://projects.scratch.mit.edu/*"
      ],
      "js": ["scripts/data/selector-map.js", "scripts/core/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://code-cadets.getlearnworlds.com/*",
        "https://*.getlearnworlds.com/*"
      ],
      "js": ["scripts/services/learnworlds-user.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/selector-map.json", "images/mascot.png", "images/logo.png", "icons/robot.png", "icons/logo/icon.png", "pages/profile.html", "scripts/pages/profile.js", "scripts/services/database-service.js", "scripts/avatar/avatar-utils.js", "scripts/avatar/lpc-integration.js", "scripts/avatar/character-builder.js", "scripts/avatar/avatar-customizer.js", "vendor/jszip.min.js", "iconpack/Png/star.png", "assets/lpc/*"],
      "matches": ["https://scratch.mit.edu/*", "https://projects.scratch.mit.edu/*"]
    }
  ]
}

