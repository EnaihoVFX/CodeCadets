{
  "manifest_version": 3,
  "name": "Cadet Help",
  "version": "1.0.0",
  "description": "Simple Scratch companion for Code Cadets training",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "downloads",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://cdnjs.cloudflare.com/*",
    "https://scratch.mit.edu/*",
    "https://projects.scratch.mit.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cadet Help",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scratch.mit.edu/*",
        "https://projects.scratch.mit.edu/*"
      ],
      "js": ["selector-map.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selector-map.json", "mascot.png", "logo.png", "icons/robot.png", "vendor/jszip.min.js"],
      "matches": ["https://scratch.mit.edu/*", "https://projects.scratch.mit.edu/*"]
    }
  ]
}

